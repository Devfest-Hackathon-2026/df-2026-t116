# コピーして .env にする。値をコミットしない
# APIキーは使わない（Vertex AI は ADC）。本番の値は apphosting.yaml
# GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID

# --- アプリ（#26）。既定は手元用（memory・fake） ---
# DATA_BACKEND=memory          # memory | firestore
# IMAGE_BACKEND=               # memory | storage（省くと DATA_BACKEND に合わせる）
# GENERATOR=fake               # fake | vertex（#27）
# GEN_TIMEOUT_SEC=120
# ページが自動で決まるまでの秒（完成2本以上／1本だけ）
# CONFIRM_AFTER_SEC=
# CONFIRM_SINGLE_AFTER_SEC=
# LIMIT_PER_USER=10
# LIMIT_GLOBAL=120
# STORAGE_BUCKET=              # 省くと ${GOOGLE_CLOUD_PROJECT}.firebasestorage.app
# GOOGLE_CLOUD_LOCATION=global
# NEXT_PUBLIC_DEV_USER=        # memory の時に x-dev-user として送る名前
# 画面の Firebase 設定（App Hosting では自動。手元で firestore を試す時だけ）
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_APP_ID=
